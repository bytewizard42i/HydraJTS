    "@types/node": "^24.5.2",
    "@upstash/redis": "^1.35.4",
    "dotenv": "^16.4.5",
    "effect": "^3.17.14",
    "redis": "^5.8.2",
    "solid-js": "^1.9.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vinxi": "^0.5.7"
