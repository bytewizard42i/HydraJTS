# HydraJTS Environment Configuration
# Copy this file to .env and populate with your values

# Proof Server Configuration
MIDNIGHT_PROOF_SERVER_URL=http://localhost:6300
MIDNIGHT_API_KEY=your-api-key-here

# Concurrency & Performance Settings
MAX_CONCURRENCY=3
REQUEST_TIMEOUT_MS=30000
RETRY_MAX_ATTEMPTS=3

# Redis Configuration (optional - uses in-memory queue if not provided)
REDIS_URL=redis://localhost:6379

# Development Settings
DIAGNOSTICS=false
DEBUG_MODE=false

# Network Settings
PROOF_SERVER_HEALTH_CHECK_INTERVAL=15000
BACKOFF_BASE_MS=500
BACKOFF_MAX_MS=10000

# UI Settings
AUTO_INSTANCE_MODE=false
DEFAULT_RESOLUTION_LAYERS=3
SHOW_PROGRESS_INDICATORS=true
