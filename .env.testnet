# Midnight Testnet Configuration
# This file contains environment variables for connecting to Midnight testnet

# Proof Server Configuration
MIDNIGHT_PROOF_SERVER_URL=http://localhost:6300
MIDNIGHT_METRICS_URL=http://localhost:6301/metrics
MIDNIGHT_NETWORK=testnet

# API Keys (if required for testnet)
# MIDNIGHT_API_KEY=your_api_key_here

# Circuit Paths
CIRCUITS_DIR=./circuits
PROOF_ARTIFACTS_DIR=./proof-artifacts

# Performance Configuration
MAX_CONCURRENT_PROOFS=10
PROOF_TIMEOUT_MS=30000
RETRY_ATTEMPTS=3
RETRY_DELAY_MS=1000

# Redis Configuration (optional)
REDIS_URL=redis://localhost:6379
USE_REDIS_QUEUE=true

# Logging
LOG_LEVEL=info
ENABLE_METRICS=true
