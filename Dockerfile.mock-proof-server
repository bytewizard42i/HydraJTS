FROM node:20-alpine

WORKDIR /app

# Create package.json for dependencies
RUN echo '{"name":"mock-proof-server","version":"1.0.0"}' > package.json

# Install required packages
RUN npm install express cors body-parser

# Copy the mock server code
COPY mock-proof-server.js .

# Expose the port
EXPOSE 6300

# Health check
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:6300/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1))"

# Start the server
CMD ["node", "mock-proof-server.js"]
